rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wholesale_products/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
